@model IEnumerable<MoviesAdmin.Models.AudienceRating>

@{
    ViewData["Title"] = "Audience Ratings";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Audience Ratings</h1>
    <a asp-action="Create" class="btn btn-primary">Add New Audience Rating</a>
</div>

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Title)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@Html.DisplayFor(modelItem => item.Title)</td>
            <td class="text-end">
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-secondary btn-sm">Edit</a>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-secondary btn-sm">Details</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
