@model IEnumerable<MoviesAdmin.Models.Movie>

@{
    ViewData["Title"] = "Movie List";
}

@* H1 and add movie button*@
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>List of Movies</h1>

    <a asp-action="Create" class="btn btn-primary">Add New Movie</a>
</div>

@* Search bar and searcj button*@
@* Will make this update live in the future *@
<form asp-action="Index" method="get" class="d-flex mb-3">
    <input type="text" name="searchString" class="form-control me-2" placeholder="Search movies by title or genre..." />

    <button type="submit" class="btn btn-primary">Search</button>
</form>

<table class="table">
    <thead>
        <tr>
            <th>
                <!-- Blank space for image -->
            </th>
            @* <th>
                @Html.DisplayNameFor(model => model.Id)
            </th> *@
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.GenreId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AudienceRatingId)
            </th>
            <th class="text-nowrap">
                @Html.DisplayNameFor(model => model.ReleaseDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Runtime)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                <img src="@item.ImageUrl" alt="@item.Title" class="thumbnail" />
            </td>

            @* <td>
                @Html.DisplayFor(model => item.Id)
            </td> *@
            <td>
                @Html.DisplayFor(model => item.Title)
            </td>
            <td>
                @Html.DisplayFor(model => item.Genre.Title)
            </td>
            <td>
                @Html.DisplayFor(model => item.AudienceRating.Title)
            </td>
            <td class="text-nowrap">
                    @item.ReleaseDate.ToString("MMM dd, yyyy")
            </td>
                <td>
                    @TimeSpan.FromMinutes(item.Runtime).ToString(@"h\hmm\m")
                </td>
                <td class="align-middle">
                    <div class="d-flex flex-column gap-2" style="width: 60px">
                        
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-secondary btn-sm">Edit</a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-secondary btn-sm">Details</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-secondary btn-sm">Delete</a>
                        }
                        else
                        {
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-secondary btn-sm">Details</a>
                        }
                    </div>
                </td>
        </tr>
}
    </tbody>
</table>
